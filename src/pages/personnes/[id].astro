---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../helper.ts";
import Image from "astro/components/Image.astro";
import ListeFilms from "../../components/ListeFilms.astro";

import placeHolder from "../../assets/images/placeholder.png";

export async function getStaticPaths() {
  const personnes = await getCollection("personnes");
  return personnes.map((personne) => ({
    params: { id: personne.id },
    props: { personne },
  }));
}

const { personne } = Astro.props;
const {Content} = await render(personne);

const films = await getCollection("films");
let filmsRealised: any[] = [];
let filmsProduced: any[] = [];
let filmsActedIn: any[] = [];

films.filter((film) => {
  // Si films réalisés, ajouter à la liste des films réalisés
  if (film.data.realisateur?.id === personne.id) {
    filmsRealised.push(film);
    return true;
  };
  // Si films produits, ajouter à la liste des films produits
  if (film.data.producteurs?.some(prod => prod.id === personne.id)) {
    filmsProduced.push(film);
    return true;
  };
  // Si films où la personne a joué, ajouter à la liste des films joués
  if (film.data.roles?.some(role => role.acteur.id === personne.id)) {
    filmsActedIn.push(film);
    return true;
  };
  return false;
});
---


<Layout title={personne.data.nom}>
    <a
        href="/personnes"
        class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors mb-8 hover:underline"
      >
        ← Retourner aux personnes
      </a>
    <h1>{personne.data.nom}</h1>
    <ListeFilms filmsRealised={filmsRealised} filmsProduced={filmsProduced} filmsActedIn={filmsActedIn}></ListeFilms>
    <Image 
        src={personne.data.image ? personne.data.image : placeHolder} 
        alt={personne.data.nom} 
        width="300" 
        height="450"
    />
    <p>{formatDate(personne.data.dateDeNaissance)}</p>
    <p>{personne.data.professions?.join(", ")}</p>
    <Content />
</Layout>
