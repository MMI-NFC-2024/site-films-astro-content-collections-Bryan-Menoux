---
import Layout from "../layouts/Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title}>
  <div>
    <h1>{frontmatter.title}</h1>
    <div class="prose prose-slate prose-xl max-w-none prose-headings:text-blue-800 prose-p:text-gray-700 prose-strong:text-black"><slot /></div>
  </div>
</Layout>
